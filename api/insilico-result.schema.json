{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayflux.github.io/Kinetics/api/insilico-result.schema.json",
  "title": "Kinetics research-only docking and MD result envelope",
  "description": "Provenance and metric contract only; does not assert scientific validity or binding affinity.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "job_type", "research_only", "validation_status", "engine", "input_hashes", "protocol", "protocol_sha256", "poses", "limitations"],
      "properties": {
        "schema_version": {"const": 1},
        "job_type": {"const": "docking"},
        "research_only": {"const": true},
        "validation_status": {"const": "not_independently_validated"},
        "engine": {"$ref": "#/$defs/engine"},
        "input_hashes": {"$ref": "#/$defs/input_hashes"},
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": ["center_angstrom", "box_size_angstrom", "seed", "exhaustiveness", "n_poses_requested", "cpu", "scoring_function", "energy_range_kcal_per_mol"],
          "properties": {
            "center_angstrom": {"$ref": "#/$defs/vector3"},
            "box_size_angstrom": {"$ref": "#/$defs/positive_vector3"},
            "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "exhaustiveness": {"type": "integer", "minimum": 1, "maximum": 128},
            "n_poses_requested": {"type": "integer", "minimum": 1, "maximum": 20},
            "cpu": {"type": "integer", "minimum": 1, "maximum": 32},
            "scoring_function": {"enum": ["vina", "vinardo"]},
        "platform": {"const": "CPU"},
            "energy_range_kcal_per_mol": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
          }
        },
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "poses": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rank", "score", "score_unit", "pose_sha256", "pose_pdbqt"],
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "score": {"type": "number"},
              "score_unit": {"type": "string", "minLength": 1},
              "pose_sha256": {"$ref": "#/$defs/sha256"},
              "pose_pdbqt": {"type": "string", "minLength": 1, "maxLength": 16777216},
              "redocking_rmsd_angstrom": {"type": ["number", "null"], "minimum": 0}
            }
          }
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "job_type", "research_only", "validation_status", "engine", "input_hashes", "force_field", "protocol", "protocol_sha256", "replicas", "limitations"],
      "properties": {
        "schema_version": {"const": 1},
        "job_type": {"const": "molecular_dynamics"},
        "research_only": {"const": true},
        "validation_status": {"const": "not_independently_validated"},
        "engine": {"$ref": "#/$defs/engine"},
        "input_hashes": {"$ref": "#/$defs/input_hashes"},
        "force_field": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "version", "parameter_source_sha256"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "parameter_source_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "protocol": {
          "type": "object", "additionalProperties": false,
          "required": ["temperature_kelvin", "pressure_bar", "timestep_fs", "steps", "equilibration_steps", "replicas", "seed", "report_interval", "cpu_threads", "platform", "integrator", "friction_per_ps"],
          "properties": {
            "temperature_kelvin": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000},
            "pressure_bar": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 10000},
            "timestep_fs": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
            "steps": {"type": "integer", "minimum": 1, "maximum": 10000000},
            "equilibration_steps": {"type": "integer", "minimum": 0, "maximum": 1000000},
            "replicas": {"type": "integer", "minimum": 2, "maximum": 10},
            "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
            "report_interval": {"type": "integer", "minimum": 1},
            "cpu_threads": {"type": "integer", "minimum": 1, "maximum": 64},
            "platform": {"const": "CPU"},
            "integrator": {"const": "LangevinMiddleIntegrator"},
            "friction_per_ps": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "replicas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["replica_id", "seed", "steps_completed", "initial_potential_energy", "final_potential_energy", "energy_unit", "trajectory_sha256"],
            "properties": {
              "replica_id": {"type": "integer", "minimum": 1},
              "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
              "steps_completed": {"type": "integer", "minimum": 1},
              "initial_potential_energy": {"type": "number"},
              "final_potential_energy": {"type": "number"},
              "energy_unit": {"type": "string", "minLength": 1},
              "trajectory_sha256": {"$ref": "#/$defs/sha256"},
              "trajectory_dcd_base64": {"type": "string", "minLength": 1, "maxLength": 44739244}
            }
          }
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "vector3": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 3, "maxItems": 3},
    "positive_vector3": {"type": "array", "prefixItems": [{"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}, {"type": "number", "exclusiveMinimum": 0}], "minItems": 3, "maxItems": 3},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "version", "build_sha256"],
      "properties": {
        "engine_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build_sha256": {"$ref": "#/$defs/sha256"},
        "scoring_function": {"enum": ["vina", "vinardo"]}
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinates_or_receptor_sha256", "ligand_or_topology_sha256"],
      "properties": {
        "coordinates_or_receptor_sha256": {"$ref": "#/$defs/sha256"},
        "ligand_or_topology_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
