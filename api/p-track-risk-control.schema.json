{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P-track risk and control record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "risk_id",
    "hazard",
    "initial_severity",
    "initial_likelihood",
    "control",
    "verification_status",
    "residual_risk_status",
    "owner_role",
    "patient_data_scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "risk_id": {
      "type": "string",
      "pattern": "^P-[0-9]{3}$"
    },
    "hazard": {
      "type": "string",
      "minLength": 1
    },
    "initial_severity": {
      "enum": [
        "low",
        "moderate",
        "high",
        "critical",
        "not_assessed"
      ]
    },
    "initial_likelihood": {
      "enum": [
        "rare",
        "unlikely",
        "possible",
        "likely",
        "not_assessed"
      ]
    },
    "control": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "enum": [
        "not_tested",
        "partially_tested",
        "verified",
        "failed"
      ]
    },
    "residual_risk_status": {
      "enum": [
        "unassessed",
        "open",
        "accepted",
        "unacceptable"
      ]
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "patient_data_scope": {
      "const": "prohibited_until_p0_approval"
    },
    "evidence_url": {
      "type": "string",
      "format": "uri"
    },
    "risk_acceptance_role": {
      "type": "string",
      "minLength": 1
    },
    "risk_accepted_at": {
      "type": "string",
      "format": "date-time"
    },
    "risk_acceptance_evidence_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "residual_risk_status": {
            "const": "accepted"
          }
        },
        "required": [
          "residual_risk_status"
        ]
      },
      "then": {
        "required": [
          "risk_acceptance_role",
          "risk_accepted_at",
          "risk_acceptance_evidence_url"
        ]
      }
    }
  ]
}
