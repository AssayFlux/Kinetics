{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayflux.github.io/Kinetics/api/gff3-annotation-import.schema.json",
  "title": "Kinetics GFF3 annotation import summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "feature_count",
    "sequence_count",
    "sequence_ids",
    "feature_type_counts",
    "identified_feature_count",
    "parent_edge_count",
    "sequence_regions",
    "coordinate_system",
    "resource_limits",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "kinetics.gff3-annotation-import.v1"
    },
    "format": {
      "const": "GFF3"
    },
    "feature_count": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_count": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_type_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "identified_feature_count": {
      "type": "integer",
      "minimum": 0
    },
    "parent_edge_count": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_regions": {
      "type": "object"
    },
    "coordinate_system": {
      "const": "1-based inclusive (GFF3)"
    },
    "resource_limits": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
