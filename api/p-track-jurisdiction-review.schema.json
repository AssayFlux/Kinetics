{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P-track jurisdiction review evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "jurisdiction",
    "intended_use_version",
    "review_status",
    "reviewer_role",
    "review_date",
    "patient_data_authorized",
    "clinical_mode_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "jurisdiction": {
      "type": "string",
      "minLength": 1
    },
    "intended_use_version": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "not_started",
        "requested",
        "under_review",
        "advice_received",
        "owner_disposition_pending"
      ]
    },
    "reviewer_role": {
      "type": "string",
      "minLength": 1
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "advice_evidence_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "product_classification": {
      "enum": [
        "not_assessed",
        "research_tool_only",
        "medical_device_or_software",
        "other",
        "undetermined"
      ]
    },
    "patient_data_authorized": {
      "const": false
    },
    "clinical_mode_authorized": {
      "const": false
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "enum": [
              "advice_received",
              "owner_disposition_pending"
            ]
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "required": [
          "advice_evidence_url",
          "product_classification"
        ]
      }
    }
  ]
}
