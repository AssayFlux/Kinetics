{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayflux.github.io/Kinetics/api/hmmscan-domain-evidence.schema.json",
  "title": "Kinetics HMMER hmmscan domain evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tool",
    "hmmer_version",
    "profile_pack",
    "query_count",
    "domain_hit_count",
    "hits",
    "conclusion",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "kinetics.hmmscan-domain-evidence.v1"
    },
    "tool": {
      "const": "hmmscan"
    },
    "hmmer_version": {
      "type": "string",
      "minLength": 1
    },
    "profile_pack": {
      "type": "object",
      "required": [
        "name",
        "version",
        "license",
        "source",
        "content_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "query_count": {
      "type": "integer",
      "minimum": 0
    },
    "domain_hit_count": {
      "type": "integer",
      "minimum": 0
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "profile_length",
          "query_id",
          "query_length",
          "full_sequence_evalue",
          "full_sequence_score",
          "domain_number",
          "domain_count",
          "conditional_evalue",
          "independent_evalue",
          "domain_score",
          "hmm_start_1based",
          "hmm_end_1based",
          "alignment_start_1based",
          "alignment_end_1based",
          "envelope_start_1based",
          "envelope_end_1based",
          "accuracy",
          "description"
        ],
        "properties": {
          "profile_id": {
            "type": "string",
            "minLength": 1
          },
          "profile_length": {
            "type": "integer",
            "minimum": 1
          },
          "query_id": {
            "type": "string",
            "minLength": 1
          },
          "query_length": {
            "type": "integer",
            "minimum": 1
          },
          "full_sequence_evalue": {
            "type": "number",
            "minimum": 0
          },
          "full_sequence_score": {
            "type": "number"
          },
          "domain_number": {
            "type": "integer",
            "minimum": 1
          },
          "domain_count": {
            "type": "integer",
            "minimum": 1
          },
          "conditional_evalue": {
            "type": "number",
            "minimum": 0
          },
          "independent_evalue": {
            "type": "number",
            "minimum": 0
          },
          "domain_score": {
            "type": "number"
          },
          "hmm_start_1based": {
            "type": "integer",
            "minimum": 1
          },
          "hmm_end_1based": {
            "type": "integer",
            "minimum": 1
          },
          "alignment_start_1based": {
            "type": "integer",
            "minimum": 1
          },
          "alignment_end_1based": {
            "type": "integer",
            "minimum": 1
          },
          "envelope_start_1based": {
            "type": "integer",
            "minimum": 1
          },
          "envelope_end_1based": {
            "type": "integer",
            "minimum": 1
          },
          "accuracy": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "conclusion": {
      "type": "object",
      "required": [
        "status",
        "family_or_domain_assignment",
        "function",
        "novelty"
      ],
      "properties": {
        "status": {
          "enum": [
            "profile_matches_reported",
            "no_profile_matches_reported"
          ]
        },
        "family_or_domain_assignment": {
          "enum": [
            "candidate_profile_matches_require_review",
            "not_established"
          ]
        },
        "function": {
          "const": "not_inferred"
        },
        "novelty": {
          "const": "not_established"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
