{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kinetics:engine-envelope:v1",
  "title": "Kinetics cross-component engine message envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "kind",
    "request_id",
    "created_at_utc",
    "operation",
    "engine",
    "source_sha256",
    "units"
  ],
  "properties": {
    "schema": {
      "const": "kinetics.engine-envelope.v1"
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "request",
        "result",
        "error"
      ]
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "source_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "units": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "input": {
      "type": "object"
    },
    "output": {
      "type": "object"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "retryable",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "UNSUPPORTED_VERSION",
            "UNSUPPORTED_OPERATION",
            "UNAUTHENTICATED",
            "PERMISSION_DENIED",
            "RESOURCE_LIMIT",
            "CANCELLED",
            "DEPENDENCY_UNAVAILABLE",
            "INTEGRITY_FAILURE",
            "PARSE_FAILURE",
            "NUMERICAL_FAILURE",
            "INTERNAL_ERROR"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "request"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "input"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "output"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "result"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "output"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "input"
              ]
            },
            {
              "required": [
                "error"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "error"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "error"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "input"
              ]
            },
            {
              "required": [
                "output"
              ]
            }
          ]
        }
      }
    }
  ]
}
