{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayflux.github.io/Kinetics/api/gff3-annotation-import.schema.json",
  "title": "Kinetics GFF3 annotation import summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format",
    "feature_count",
    "sequence_count",
    "sequence_ids",
    "feature_type_counts",
    "identified_feature_count",
    "parent_edge_count",
    "sequence_regions",
    "coordinate_system",
    "resource_limits",
    "limitations",
    "features"
  ],
  "properties": {
    "schema": {
      "const": "kinetics.gff3-annotation-import.v1"
    },
    "format": {
      "const": "GFF3"
    },
    "feature_count": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_count": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_type_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "identified_feature_count": {
      "type": "integer",
      "minimum": 0
    },
    "parent_edge_count": {
      "type": "integer",
      "minimum": 0
    },
    "sequence_regions": {
      "type": "object"
    },
    "coordinate_system": {
      "const": "1-based inclusive (GFF3)"
    },
    "resource_limits": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "seqid",
          "source",
          "type",
          "start",
          "end",
          "score",
          "strand",
          "phase",
          "attributes"
        ],
        "properties": {
          "seqid": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": [
              "number",
              "null"
            ]
          },
          "strand": {
            "enum": [
              "+",
              "-",
              ".",
              "?"
            ]
          },
          "phase": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
