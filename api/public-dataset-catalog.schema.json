{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayflux.github.io/Kinetics/api/public-dataset-catalog.schema.json",
  "title": "Kinetics public non-patient dataset catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "purpose",
    "data_classification",
    "entries",
    "candidate_sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "data_classification": {
      "const": "public_non_patient_only"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset_id",
          "title",
          "source_url",
          "accession_or_version",
          "license",
          "license_review_status",
          "intended_use",
          "retrieved_at",
          "content_sha256",
          "patient_data",
          "license_url"
        ],
        "properties": {
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "accession_or_version": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "license_url": {
            "type": "string",
            "format": "uri"
          },
          "license_review_status": {
            "enum": [
              "not_reviewed",
              "approved_for_research",
              "prohibited"
            ]
          },
          "intended_use": {
            "type": "string",
            "minLength": 1
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "patient_data": {
            "const": false
          },
          "notes": {
            "type": "string"
          },
          "license_review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer",
              "reviewed_at",
              "approved_scope",
              "evidence_url"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "approved_scope": {
                "type": "string",
                "minLength": 1
              },
              "evidence_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "license_review_status": {
                  "const": "approved_for_research"
                }
              },
              "required": [
                "license_review_status"
              ]
            },
            "then": {
              "required": [
                "license_review"
              ]
            }
          }
        ]
      }
    },
    "candidate_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "title",
          "source_url",
          "candidate_use",
          "license_review_status",
          "patient_data",
          "notes"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "candidate_use": {
            "type": "string",
            "minLength": 1
          },
          "license_review_status": {
            "const": "verify_before_intake"
          },
          "patient_data": {
            "const": false
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
