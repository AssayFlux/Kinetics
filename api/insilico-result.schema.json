{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayflux.github.io/Kinetics/api/insilico-result.schema.json",
  "title": "Kinetics research-only docking and MD result envelope",
  "description": "Provenance and metric contract only; does not assert scientific validity or binding affinity.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "job_type", "research_only", "validation_status", "engine", "input_hashes", "protocol_sha256", "poses", "limitations"],
      "properties": {
        "schema_version": {"const": 1},
        "job_type": {"const": "docking"},
        "research_only": {"const": true},
        "validation_status": {"const": "not_independently_validated"},
        "engine": {"$ref": "#/$defs/engine"},
        "input_hashes": {"$ref": "#/$defs/input_hashes"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "poses": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rank", "score", "score_unit", "pose_sha256"],
            "properties": {
              "rank": {"type": "integer", "minimum": 1},
              "score": {"type": "number"},
              "score_unit": {"type": "string", "minLength": 1},
              "pose_sha256": {"$ref": "#/$defs/sha256"},
              "redocking_rmsd_angstrom": {"type": ["number", "null"], "minimum": 0}
            }
          }
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "job_type", "research_only", "validation_status", "engine", "input_hashes", "protocol_sha256", "replicas", "limitations"],
      "properties": {
        "schema_version": {"const": 1},
        "job_type": {"const": "molecular_dynamics"},
        "research_only": {"const": true},
        "validation_status": {"const": "not_independently_validated"},
        "engine": {"$ref": "#/$defs/engine"},
        "input_hashes": {"$ref": "#/$defs/input_hashes"},
        "protocol_sha256": {"$ref": "#/$defs/sha256"},
        "replicas": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["replica_id", "seed", "steps_completed", "initial_potential_energy", "final_potential_energy", "energy_unit", "trajectory_sha256"],
            "properties": {
              "replica_id": {"type": "integer", "minimum": 1},
              "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
              "steps_completed": {"type": "integer", "minimum": 1},
              "initial_potential_energy": {"type": "number"},
              "final_potential_energy": {"type": "number"},
              "energy_unit": {"type": "string", "minLength": 1},
              "trajectory_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "limitations": {"$ref": "#/$defs/limitations"}
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "version", "build_sha256"],
      "properties": {
        "engine_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "build_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinates_or_receptor_sha256", "ligand_or_topology_sha256"],
      "properties": {
        "coordinates_or_receptor_sha256": {"$ref": "#/$defs/sha256"},
        "ligand_or_topology_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
