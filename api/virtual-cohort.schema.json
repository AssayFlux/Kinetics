{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assayflux.github.io/Kinetics/api/virtual-cohort.schema.json",
  "title": "Kinetics synthetic aggregate virtual cohort",
  "description": "Synthetic Hardy-Weinberg aggregate counts only; no individual genotypes or clinical risk.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "simulation", "data_classification", "sample_size", "seed", "loci", "assumptions", "limitations", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "simulation": {"const": "independent-locus Hardy-Weinberg synthetic aggregate cohort"},
    "data_classification": {"const": "synthetic_non_patient"},
    "sample_size": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "loci": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locus_id", "alternate_allele_frequency", "reference_allele_frequency", "genotype_order", "observed_synthetic_counts", "expected_hardy_weinberg_counts"],
        "properties": {
          "locus_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "alternate_allele_frequency": {"type": "number", "minimum": 0, "maximum": 1},
          "reference_allele_frequency": {"type": "number", "minimum": 0, "maximum": 1},
          "genotype_order": {"const": ["reference_homozygous", "heterozygous", "alternate_homozygous"]},
          "observed_synthetic_counts": {
            "type": "array", "prefixItems": [
              {"type": "integer", "minimum": 0},
              {"type": "integer", "minimum": 0},
              {"type": "integer", "minimum": 0}
            ], "minItems": 3, "maxItems": 3
          },
          "expected_hardy_weinberg_counts": {
            "type": "array", "prefixItems": [
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0}
            ], "minItems": 3, "maxItems": 3
          }
        }
      }
    },
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "seeded_prng"],
      "properties": {
        "generator": {"const": "Kinetics synthetic HWE generator"},
        "seeded_prng": {"const": "Python random.Random"}
      }
    }
  }
}
